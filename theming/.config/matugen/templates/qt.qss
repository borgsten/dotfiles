/*
 * Qt style sheet applied to all Qt apps through qt5ct/qt6ct.
 * Fusion draws checkbox and group box borders as a shade of the window
 * colour, which disappears on dark themes; draw them with the border roles.
 * Image URLs must be absolute, Qt resolves them against the working directory;
 * @HOME@ is filled in by the post_hook.
 */
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid {{colors.outline.default.hex}};
    border-radius: 3px;
    background: {{colors.surface_container_low.default.hex}};
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked {
    border-color: {{colors.primary.default.hex}};
    background: {{colors.primary.default.hex}};
    image: url(@HOME@/.cache/theming/qt-check.svg);
}
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate {
    border-color: {{colors.primary.default.hex}};
    background: {{colors.primary.default.hex}};
    image: url(@HOME@/.cache/theming/qt-partial.svg);
}
QCheckBox::indicator:disabled, QGroupBox::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: {{colors.outline_variant.default.hex}};
    background: transparent;
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled {
    background: {{colors.surface_container_high.default.hex}};
    image: url(@HOME@/.cache/theming/qt-check-disabled.svg);
}
QGroupBox {
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: 4px;
    margin-top: 0.5em;   /* frame line runs through the middle of the title */
    padding-top: 0.5em;  /* clears the half of the title that sits inside the frame */
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    padding: 0 4px;
    background-color: palette(window);  /* hides the frame line behind the title */
}
